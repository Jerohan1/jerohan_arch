# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #141310
selected_bg = #20201c
header_bg = #48473d

# Text colors
text = #e5e2dc
selected_text = #adae81
header_text = #c9c7b9
inactive_text = #929184

# GPU utilization colors (gradient from low to high)
gpu_util_low = #d7e88b
gpu_util_med = #f7f3c0
gpu_util_high = #d5b03c

# Memory usage colors
memory_low = #cfe9a0
memory_med = #a7d489
memory_high = #75cf9d

# Temperature colors (cool to hot)
temp_cool = #d7e88b
temp_warm = #f7f3c0
temp_hot = #d5b03c

# Power usage colors
power_low = #d7e88b
power_med = #ddcf82
power_high = #d6bc71

# Process list colors
process_normal = #e5e2dc
process_highlight = #adae81
process_killed = #d5b03c

# Border and separator colors
border = #929184
separator = #48473d

# Chart and graph colors
chart_line = #b1ceb0
chart_fill = #20201c

# Status indicators
status_ok = #d7e88b
status_warning = #f7f3c0
status_error = #d5b03c
status_info = #75cf9d
